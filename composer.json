{
    "name": "msstc4php/vo-base-symfony-bridge",
    "description": "Symfony Validator constraints and a bundle for msstc4php/value-objects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "symfony",
        "validator",
        "bundle",
        "bridge",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../vo-base",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../vo-base-doctrine-bridge",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "msstc4php/value-objects": "dev-feat/value-objects-library as 1.1.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/mongodb-odm": "^2.9",
        "doctrine/mongodb-odm-bundle": "^5.0",
        "doctrine/orm": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.64",
        "msstc4php/vo-base-doctrine-bridge": "dev-main",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/validator": "^7.2"
    },
    "suggest": {
        "symfony/validator": "To validate raw input against value object rules via constraints.",
        "symfony/http-kernel": "To auto-register constraints and Doctrine types through ValueObjectBridgeBundle.",
        "msstc4php/vo-base-doctrine-bridge": "To have the bundle register the Doctrine ORM/ODM types as well."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObjectSymfonyBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObjectSymfonyBridge\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": false
        }
    }
}
